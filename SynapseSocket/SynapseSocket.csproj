<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <AssemblyName>SynapseSocket</AssemblyName>
        <RootNamespace>SynapseSocket</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Pre-nullable SynapseSocket source; previously attributed to the CodeBoost embed, but the warnings are local. -->
        <NoWarn>$(NoWarn);CS8618;CS8625</NoWarn>
        <Description>Synapse - High-Performance Multi-Stack UDP Transport Engine</Description>
        <Version>1.0.0</Version>
        <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>SynapseSocket.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\submodules\CodeBoost\CodeBoost.CodeAnalysis.Analyzers\CodeBoost.CodeAnalysis.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>

        <!--
            CodeBoost is the shared assembly checked out beside this repository, the same copy Nucleus and every integration
            reference, so a CodeBoost type is one type across the whole stack. Embedding its sources here instead would put a
            second copy of every CodeBoost type into SynapseSocket.dll, and a Unity assembly referencing both DLLs cannot
            disambiguate them: Unity has no extern alias. SynapseSocket.dll therefore ships beside CodeBoost.dll.
        -->
        <ProjectReference Include="..\..\CodeBoost\CodeBoost\CodeBoost.csproj"/>

        <!-- Only needed on netstandard2.1; built into net7.0+ -->
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="5.0.0" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
    </ItemGroup>
    
</Project>
